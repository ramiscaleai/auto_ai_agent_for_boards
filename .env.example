# --- Trello (sub-project A) ---
TRELLO_API_KEY=
TRELLO_SECRET=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_BOARD_NAME=
TRELLO_TO_DO_LIST_NAME=To Do
TRELLO_BACKLOG_LIST_NAME=Backlog

# --- AI Agent layer (sub-project B) ---
# OpenCodeAgent API keys (needed only when openrouter/claude slots are used):
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Max minutes to wait for a single LLM/agent run before killing it (default: 30):
# AGENT_TIMEOUT_MIN=30

# CodexAgent defaults (also set in config/agents.yml):
# CODEX_MODEL=gpt-5.5
# CODEX_REASONING_EFFORT=xhigh

# Budget caps (defaults shown):
COST_PER_TASK_USD=0.50
COST_PER_DAY_USD=5.00

# Priority chain overrides (optional; YAML defaults used if unset):
# AI_CODING_PRIORITY=codex,gemini,openrouter,claude
# AI_STRUCTURED_PRIORITY=codex,gemini,litellm:openai/gpt-4o-mini

# Observability — Langfuse (optional; tracing disabled if unset):
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# CostGuard state file (defaults to ~/.cache/auto_ai_agent/spend.json):
# COST_STATE_PATH=

# --- Repo identification (sub-project C) ---
# Path to repos.md (defaults to repos.md in the repo root):
# REPOS_MD_PATH=

# --- Orchestration loop (sub-project E) ---
TRELLO_TO_REVIEW_LIST_NAME=To Review
TRELLO_WAITING_LIST_NAME=Waiting for answers
# Poll interval in seconds (default: 60):
# POLL_INTERVAL_S=60

# --- Stuck / auto-answer flow (sub-project F) ---
# Hours before auto-answering a waiting card (default: 48):
# AUTO_ANSWER_HOURS=48

# Max UTF-8 bytes reserved for the prompt Discussion block before oldest comments are omitted:
# PROMPT_COMMENT_BUDGET_BYTES=16000

# --- Systemd service scheduling ---
# Minutes to wait after each agent run finishes before starting the next (default: 5):
# AGENT_POLL_INTERVAL_MIN=5
